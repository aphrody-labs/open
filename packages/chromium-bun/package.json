    "./engines": "./src/engines/index.ts",
    "./net": "./src/net/probe.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "bench": "bun run src/benchmarks/runner.ts",
    "inspect": "bun run src/audit/chromium-inspector.ts",
    "test": "bun test",
    "check": "bun check",
    "fmt": "bun fmt",
    "test:e2e-auth": "bun test test/gemini.e2e-auth.test.ts",
    "probe": "bun src/net/probe.ts"
  },
