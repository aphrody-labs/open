{
  "$comment": "One headless profile for browser agents (agent-browser, browser-engines, headless Chromium). Each entry cites its definition in the Chromium source (version of the checkout the profile was verified against).",
  "chromium": "157.0.8103.78",
  "source": "chromium/src@157.0.8103.78",
  "notes": [
    "base/command_line.cc:436-455: a repeated switch keeps its last value (no DuplicateSwitchHandler outside tests). agent-browser appends user arguments after its own, so the profile's --disable-features replaces its --disable-features=Translate.",
    "Translate is not a base::Feature in Chromium 157 (components/translate/core/common/translate_features.cc defines only TranslateTrigger, TranslateSimplifiedHindi, ...): agent-browser's --disable-features=Translate has no effect; translation is turned off by the TranslateEnabled policy on Linux.",
    "chrome/browser/headless/headless_mode_util.cc:21: headless mode only tests that --headless is present; the =new value is ignored in 157 (the old headless is the separate headless_shell binary).",
    "chrome/browser/devtools/remote_debugging_server.cc:90,133: the CDP port listens on 127.0.0.1 only."
  ],
  "args": [
    {
      "arg": "--headless=new",
      "os": [
        "linux",
        "win"
      ],
      "src": "components/embedder_support/switches.h (kHeadless) ; chrome/browser/headless/headless_mode_util.cc:21",
      "why": "full browser without a window"
    },
    {
      "arg": "--no-first-run",
      "os": [
        "linux",
        "win"
      ],
      "src": "chrome/common/chrome_switches.h:528",
      "why": "no first-run wizard"
    },
    {
      "arg": "--no-default-browser-check",
      "os": [
        "linux",
        "win"
      ],
      "src": "chrome/common/chrome_switches.h:507",
      "why": "no default-browser check"
    },
    {
      "arg": "--disable-background-networking",
      "os": [
        "linux",
        "win"
      ],
      "src": "chrome/common/chrome_switches.h:238",
      "why": "no background traffic (variations, promotions, prefetch)"
    },
    {
      "arg": "--disable-component-update",
      "os": [
        "linux",
        "win"
      ],
      "src": "chrome/common/chrome_switches.h:245",
      "why": "no component download when a disposable profile starts"
    },
    {
      "arg": "--disable-default-apps",
      "os": [
        "linux",
        "win"
      ],
      "src": "chrome/common/chrome_switches.h:254",
      "why": "no default apps installation"
    },
    {
      "arg": "--disable-domain-reliability",
      "os": [
        "linux",
        "win"
      ],
      "src": "chrome/common/chrome_switches.h:262",
      "why": "no Domain Reliability beacons"
    },
    {
      "arg": "--no-pings",
      "os": [
        "linux",
        "win"
      ],
      "src": "chrome/common/chrome_switches.h:535",
      "why": "no <a ping> hyperlink auditing"
    },
    {
      "arg": "--disable-sync",
      "os": [
        "linux",
        "win"
      ],
      "src": "components/sync/base/command_line_switches.h:11",
      "why": "no account sync"
    },
    {
      "arg": "--metrics-recording-only",
      "os": [
        "linux",
        "win"
      ],
      "src": "components/metrics/metrics_switches.h:49",
      "why": "local metrics only, nothing uploaded"
    },
    {
      "arg": "--disable-breakpad",
      "os": [
        "linux",
        "win"
      ],
      "src": "base/base_switches.h:15",
      "why": "no crash handler (crashpad): one process less"
    },
    {
      "arg": "--mute-audio",
      "os": [
        "linux",
        "win"
      ],
      "src": "media/base/media_switches.cc:183",
      "why": "no audio output for a server or agent"
    },
    {
      "arg": "--disable-renderer-backgrounding",
      "os": [
        "linux",
        "win"
      ],
      "src": "content/public/common/content_switches.cc:243",
      "why": "an agent's background tabs keep their priority"
    },
    {
      "arg": "--disable-background-timer-throttling",
      "os": [
        "linux",
        "win"
      ],
      "src": "content/public/common/content_switches.cc:97",
      "why": "timers are not throttled in background tabs"
    },
    {
      "arg": "--disable-backgrounding-occluded-windows",
      "os": [
        "linux",
        "win"
      ],
      "src": "content/public/common/content_switches.cc:93",
      "why": "occluded windows are not put to sleep"
    },
    {
      "arg": "--disk-cache-size=268435456",
      "os": [
        "linux",
        "win"
      ],
      "src": "chrome/common/chrome_switches.h:288",
      "why": "disk cache capped at 256 MiB for a persistent profile"
    },
    {
      "arg": "--password-store=basic",
      "os": [
        "linux"
      ],
      "src": "components/password_manager/core/browser/password_manager_switches.cc:13",
      "why": "no keyring (gnome-keyring, kwallet) on a server"
    }
  ],
  "disableFeatures": [
    {
      "name": "BackForwardCache",
      "src": "content/public/common/content_features.cc:182",
      "why": "an agent browses serially in one tab: pages it left do not stay in memory"
    },
    {
      "name": "OptimizationHints",
      "src": "components/optimization_guide/core/optimization_guide_features.cc:60",
      "why": "no optimization hints fetch"
    },
    {
      "name": "MediaRouter",
      "src": "chrome/browser/media/router/media_router_feature.cc:47",
      "why": "no Cast/DIAL discovery"
    },
    {
      "name": "AutofillServerCommunication",
      "src": "components/autofill/core/common/autofill_debug_features.cc:143",
      "why": "no Autofill server queries"
    }
  ],
  "gpu": {
    "$comment": "software = host without a GPU; hardware = real GPU (ANGLE, D3D11 by default on Windows); off = GPU disabled without an explicit SwiftShader fallback. On a GPU-less Linux host, --disable-gpu with SwiftShader used 422 MB against 504 MB with --use-angle=swiftshader; WebGL2 works in both.",
    "software": [
      {
        "arg": "--disable-gpu",
        "src": "content/public/common/content_switches.cc:134",
        "why": "no attempt at a missing GPU driver; software compositing"
      },
      {
        "arg": "--enable-unsafe-swiftshader",
        "src": "ui/gl/gl_switches.cc:168",
        "why": "keeps WebGL2 through the SwiftShader (CPU) fallback; agent-browser adds it in headless mode too"
      }
    ],
    "hardware": [],
    "off": [
      {
        "arg": "--disable-gpu",
        "src": "content/public/common/content_switches.cc:134",
        "why": "software compositing"
      }
    ],
    "rejected": [
      {
        "arg": "--use-angle=swiftshader",
        "src": "ui/gl/gl_switches.cc:102",
        "why": "measured on a GPU-less Linux host: 82 MB more final RAM than --disable-gpu, no gain"
      }
    ],
    "default": {
      "linux": "software",
      "win": "hardware"
    }
  },
  "policies": {
    "$comment": "Linux only: written to Chrome's managed policy directory (/etc/opt/chrome/policies/managed/). On Windows the headless Chrome reads the user's HKLM/HKCU Chrome policies: nothing is set there. Definitions: components/policy/resources/templates/policy_definitions/.",
    "linux": {
      "BackgroundModeEnabled": {
        "value": false,
        "src": "Miscellaneous/BackgroundModeEnabled.yaml (chrome.linux:19-)"
      },
      "MetricsReportingEnabled": {
        "value": false,
        "src": "Miscellaneous/MetricsReportingEnabled.yaml (chrome.*:8-)"
      },
      "TranslateEnabled": {
        "value": false,
        "src": "Miscellaneous/TranslateEnabled.yaml (chrome.*:12-)"
      },
      "SpellcheckEnabled": {
        "value": false,
        "src": "Miscellaneous/SpellcheckEnabled.yaml (chrome.*:65-)"
      },
      "PasswordManagerEnabled": {
        "value": false,
        "src": "PasswordManager/PasswordManagerEnabled.yaml (chrome.*:8-)"
      },
      "AutofillAddressEnabled": {
        "value": false,
        "src": "Miscellaneous/AutofillAddressEnabled.yaml (chrome.*:69-)"
      },
      "AutofillCreditCardEnabled": {
        "value": false,
        "src": "Miscellaneous/AutofillCreditCardEnabled.yaml (chrome.*:63-)"
      },
      "PromotionsEnabled": {
        "value": false,
        "src": "Miscellaneous/PromotionsEnabled.yaml (chrome.*:128-)"
      },
      "DiskCacheSize": {
        "value": 268435456,
        "src": "Miscellaneous/DiskCacheSize.yaml (chrome.*:17-)"
      }
    }
  },
  "excluded": [
    {
      "arg": "--no-sandbox",
      "why": "sandbox kept: needs a setuid chrome-sandbox or unprivileged user namespaces on the host; launch verified with the sandbox on"
    },
    {
      "arg": "--disable-ipc-flooding-protection",
      "why": "browser process protection (content_switches.cc:167): excluded"
    },
    {
      "arg": "--disable-client-side-phishing-detection",
      "why": "Safe Browsing: excluded"
    },
    {
      "arg": "--disable-dev-shm-usage",
      "why": "not needed when /dev/shm is large; agent-browser adds it by itself below 256 MiB (base/base_switches.h:153)"
    }
  ],
  "agentBrowserBaseline": {
    "$comment": "Arguments agent-browser passes by default in headless mode (its cli/src/native/cdp/chrome.rs): the comparison baseline.",
    "version": "0.42.0",
    "common": [
      "--no-first-run",
      "--no-default-browser-check",
      "--disable-background-networking",
      "--disable-backgrounding-occluded-windows",
      "--disable-component-update",
      "--disable-default-apps",
      "--disable-hang-monitor",
      "--disable-popup-blocking",
      "--disable-prompt-on-repost",
      "--disable-sync",
      "--disable-features=Translate",
      "--enable-features=NetworkService,NetworkServiceInProcess,WebMCPTesting,DevToolsWebMCPSupport",
      "--metrics-recording-only",
      "--password-store=basic",
      "--use-mock-keychain",
      "--headless=new",
      "--hide-scrollbars",
      "--enable-unsafe-swiftshader",
      "--window-size=1280,720"
    ]
  }
}
