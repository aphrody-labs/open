{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun"
    ],
    "paths": {
      "@aphrody/ai-router": [
        "../../packages/ai-router/src/index.ts"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "*.ts",
    "web/**/*.ts"
  ]
}
